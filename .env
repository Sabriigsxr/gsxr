# =============================================================================
# GSXR Pentest Intelligence — Local Environment (AUTO-GENERATED)
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=pentest-bughunter:latest
OLLAMA_ANALYSIS_MODEL=pentest-bughunter:latest
OLLAMA_CODE_MODEL=pentest-bughunter:latest
OLLAMA_TIMEOUT_MS=120000
LOCAL_MODEL_FALLBACK=true
LOCAL_CLOUD_FALLBACK_ENABLED=false

# Local OpenAI API Server
HOST=127.0.0.1
PORT=8001
API_AUTH_TOKEN=sk-local-12345
CORS_ORIGINS=*

# Database
DB_PATH=./data/gsxr_pentest.db

# OpenCode MCP (HexStrike)
HEXSTRIKE_MCP_COMMAND=python3
HEXSTRIKE_MCP_ARGS=/home/gsxr/hexstrike_mcp_simple.py,--server,http://127.0.0.1:8888
HEXSTRIKE_BACKEND_URL=http://127.0.0.1:8888

# RAG
RAG_DB=/home/gsxr/rag_db
TMPDIR=/home/gsxr/tmp

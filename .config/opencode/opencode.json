{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-openai/qwen2.5-coder-3b",
  "providers": {
    "ollama": {
      "name": "Ollama (local only)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama-local",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "pentest-bughunter:latest": {
          "name": "pentest-bughunter",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "local-openai": {
      "name": "Local OpenAI-Compatible",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "sk-local-12345",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "qwen2.5-coder-3b": {
          "name": "qwen2.5-coder-3b",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agents": {
    "local": {
      "description": "Local-only agent: Ollama on 127.0.0.1 with a slim tool set. Use when the request must not leave the host.",
      "mode": "primary",
      "model": "ollama/pentest-bughunter:latest"
    },
    "local-openai": {
      "description": "Local OpenAI-compatible agent: Qwen2.5-Coder-3B via local API server. Use for code assistance and pentest tasks.",
      "mode": "primary",
      "model": "local-openai/qwen2.5-coder-3b"
    }
  },
  "mcp": {
    "hexstrike": {
      "type": "local",
      "command": [
        "python3",
        "/home/gsxr/hexstrike_mcp_simple.py",
        "--server",
        "http://127.0.0.1:8888"
      ],
      "enabled": true,
      "timeout": 300,
      "description": "HexStrike AI v6.0 MCP server - 150+ security tools (patched: deferred HTTP connect)"
    },
    "rag": {
      "type": "local",
      "command": [
        "python3",
        "/home/gsxr/rag_mcp.py"
      ],
      "enabled": true,
      "description": "PentesterFlow RAG MCP server - ChromaDB knowledge base (2600+ pentest scenarios). Read-only retrieval of playbooks and guidance.",
      "environment": {
        "TMPDIR": "/home/gsxr/tmp",
        "RAG_DB": "/home/gsxr/rag_db"
      }
    },
    "openai-local": {
      "type": "local",
      "command": [
        "python3",
        "/home/gsxr/local_openai_server.py"
      ],
      "enabled": true,
      "description": "Local OpenAI-compatible API server proxying to Ollama on port 8001",
      "environment": {
        "LOCAL_API_KEY": "sk-local-12345"
      }
    }
  },
  "skills": {
    "paths": [
      "/home/gsxr/anthropic-cybersecurity-skills/skills"
    ],
    "urls": [
      "https://github.com/mukul975/Anthropic-Cybersecurity-Skills.git"
    ]
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" }
  ]
}
